class Solution {
    public boolean isAcronym(List<String> words, String s) {
        
        return (words.size() == s.length()) && words.stream()
                                                    .map(str -> str.substring(0, 1))
                                                    .collect(Collectors.joining())
                                                    .equals(s);
    }
}

