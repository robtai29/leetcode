class Solution {
    public int sumOfUnique(int[] nums) {
        Map<Integer, Integer> map = new HashMap<>();
        for (int num : nums){
            map.put(num, map.getOrDefault(num, 0)+1);
        }

        return map.keySet().stream()
                           .filter(key -> map.get(key)==1)
                           .mapToInt(Integer::intValue).sum();
    }
}

