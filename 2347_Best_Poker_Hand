class Solution {
    public String bestHand(int[] ranks, char[] suits) {
        boolean isFlush = IntStream.range(0, suits.length - 1)
                                   .allMatch(i -> suits[i] == suits[i + 1]);
        if (isFlush) {
            return "Flush";
        }

        Map<Integer, Long> counts = Arrays.stream(ranks).boxed()
                .collect(Collectors.groupingBy(r -> r, Collectors.counting()));
        int maxSame = Collections.max(counts.values()).intValue();

        if (maxSame >= 3) {
            return "Three of a Kind";
        } else if (maxSame == 2) {
            return "Pair";
        } else {
            return "High Card";
        }
    }
}